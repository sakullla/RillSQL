{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "澄库主窗口：默认核心权限、文件对话框和连接命令。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-app-info",
    "allow-connections-list",
    "allow-connections-save",
    "allow-connections-delete",
    "allow-connections-test",
    "allow-connections-open",
    "allow-connections-focus-database",
    "allow-connections-disconnect",
    "allow-connections-confirm-host-key",
    "allow-connections-forget-host-key",
    "allow-env-tags-list",
    "allow-env-tags-save",
    "allow-env-tags-delete",
    "allow-catalog-sessions",
    "allow-catalog-refresh",
    "allow-catalog-page",
    "allow-ddl-describe",
    "allow-ddl-preview",
    "allow-ddl-execute",
    "allow-grid-describe",
    "allow-grid-page",
    "allow-grid-count",
    "allow-grid-commit",
    "allow-grid-export",
    "allow-export-write-loaded",
    "allow-grid-export-cancel",
    "allow-query-start",
    "allow-query-poll",
    "allow-query-cancel",
    "allow-query-history",
    "allow-query-history-clear",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
